# Required: Server-side private key for contract interactions (hex, with 0x prefix)
DEV_PRIVATE_KEY=0x...

# Optional: RPC URL for Nitro DevNode (default: http://localhost:8547)
RPC_URL=http://localhost:8547

# ERC-4337 Bundler URL (local Alto or hosted like Pimlico)
# Local dev: http://localhost:4337
# Pimlico: https://api.pimlico.io/v2/421614/rpc?apikey=xxx
BUNDLER_URL=http://localhost:4337

# Optional: IPFS API URL (default: http://localhost:5001)
IPFS_API_URL=http://localhost:5001

# Optional: CORS origin (default: http://localhost:3000)
CORS_ORIGIN=http://localhost:3000

# Optional: Enable dev wallet auto-auth bypass (default: false)
# When true, the X-Dev-Wallet header creates a session without SIWE signature.
# Set to "true" in local dev to skip wallet signing. Never enable in production.
ENABLE_DEV_WALLET_AUTH=true

# Optional: Server port (default: 3001)
PORT=3001

# Redis URL for session key storage (optional, enables session keys)
REDIS_URL=redis://localhost:6379

# Foundry (Azure AI Foundry)
# OpenAI-compatible chat completions base URL (e.g. https://<resource>.openai.azure.com/openai/v1)
FOUNDRY_OPENAI_URL=https://<resource>.openai.azure.com/openai/v1
# Project management endpoint used to list deployments (e.g. https://<resource>.services.ai.azure.com/api/projects/<project>)
FOUNDRY_PROJECT_URL=https://<resource>.services.ai.azure.com/api/projects/<project>
# API key for the Foundry resource
FOUNDRY_KEY=
# API version used for the deployments REST call (default: 2025-05-01)
FOUNDRY_API_VERSION=2025-05-01
