# ═══════════════════════════════════════════════════════════
# MemoryChain - Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── DEPLOYMENT ───────────────────────────────────────────
# Directory to save deployment artifacts (default: deployments)

DEPLOYMENT_DIR=deployments

## devnet (arbitrum nitro)
ACCOUNT_ADDRESS_NITRO=
RPC_URL_NITRO=
PRIVATE_KEY_NITRO=

## sepolia (arbitrum sepolia)
ACCOUNT_ADDRESS_SEPOLIA=
RPC_URL_SEPOLIA=https://sepolia-rollup.arbitrum.io/rpc
PRIVATE_KEY_SEPOLIA=

## mainnet (arbitrum one)
ACCOUNT_ADDRESS_MAINNET=
RPC_URL_MAINNET=https://arb1.arbitrum.io/rpc
PRIVATE_KEY_MAINNET=

## nova
ACCOUNT_ADDRESS_NOVA=
RPC_URL_NOVA=
PRIVATE_KEY_NOVA=https://nova.arbitrum.io/rpc

# orbit - educhain testnet
ACCOUNT_ADDRESS_EDUCHAIN_TESTNET=
RPC_URL_EDUCHAIN_TESTNET=
PRIVATE_KEY_EDUCHAIN_TESTNET=

# orbit - educhain
ACCOUNT_ADDRESS_EDUCHAIN=
RPC_URL_EDUCHAIN=
PRIVATE_KEY_EDUCHAIN=

## orbit - superposition
ACCOUNT_ADDRESS_SUPERPOSITION=
RPC_URL_SUPERPOSITION=
PRIVATE_KEY_SUPERPOSITION=

# orbit - superposition testnet
ACCOUNT_ADDRESS_SUPERPOSITION_TESTNET=
RPC_URL_SUPERPOSITION_TESTNET=
PRIVATE_KEY_SUPERPOSITION_TESTNET=

# ── CREDIT MANAGER (optional, sensible defaults apply) ─────
# Treasury that receives ETH from credit purchases.
# If empty, the deployer/admin account is used.
# Sepolia defaults to 0x636b53B6DdA21FD7c953677ab1aA892A9957E97b when unset.
TREASURY_NITRO=
TREASURY_SEPOLIA=
TREASURY_MAINNET=

# Price per Memory Credit in Wei (default: 100000000000000 = 0.00001 ETH)
PRICE_PER_CREDIT_NITRO=
PRICE_PER_CREDIT_SEPOLIA=
PRICE_PER_CREDIT_MAINNET=
