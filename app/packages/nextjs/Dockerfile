ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS deps

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy workspace manifests first to leverage Docker cache
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/nextjs/package.json ./packages/nextjs/package.json

# Install all deps with cache mount (fast rebuilds)
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM node:${NODE_VERSION} AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME/bin:$PATH"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

WORKDIR /app

# Copy installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/nextjs/node_modules ./packages/nextjs/node_modules

# Copy application source
COPY packages/nextjs ./packages/nextjs
# Copy root config needed by biome/tooling during build
COPY biome.json ./

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# Allow build to succeed even with TS errors (matches existing Vercel config)
ENV NEXT_PUBLIC_IGNORE_BUILD_ERROR=true

# Correr build desde la raíz del monorepo para que Turbopack
# encuentre el pnpm-lock.yaml y resuelva el workspace root correctamente
RUN pnpm --filter @ss/nextjs build

# ============================================================
# Stage 3: Minimal production runner
# ============================================================
FROM node:${NODE_VERSION} AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Security: use built-in non-root user
RUN mkdir -p .next && chown node:node .next

# Copy public assets
COPY --from=builder --chown=node:node /app/packages/nextjs/public ./packages/nextjs/public

# Copy the standalone bundle — contains server.js + traced node_modules
COPY --from=builder --chown=node:node /app/packages/nextjs/.next/standalone ./
# Copy static assets into the right place for the standalone server
COPY --from=builder --chown=node:node /app/packages/nextjs/.next/static ./packages/nextjs/.next/static

USER node
EXPOSE 3000

# server.js is generated by Next.js standalone output
CMD ["node", "packages/nextjs/server.js"]
